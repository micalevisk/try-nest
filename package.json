{
  "name": "try-nest",
  "version": "0.0.0-development.1",
  "description": "A CLI tool to access NestJS samples easily.",
  "type": "module",
  "bin": {
    "try-nest": "./lib/bin/try-nest.cli.js",
    "try-nestjs": "./lib/bin/try-nest.cli.js"
  },
  "files": [
    "lib/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/micalevisk/try-nest"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rm -rf ./lib",
    "build": "tsc --project tsconfig.build.json",
    "dev": "node --watch --experimental-transform-types --experimental-detect-module ./src/bin/try-nest.cli.ts",
    "prestart": "npm run build",
    "start": "node ./lib/bin/try-nest.cli.js",
    "test": "vitest --config ./vitest.config.ts run",
    "test:drift": "TRY_NEST_LIVE=1 vitest --config ./vitest.config.ts run tests/drift",
    "watch/test": "vitest --config ./vitest.config.ts watch",
    "typecheck": "vitest --typecheck",
    "lint": "biome lint --write",
    "format": "biome format --write"
  },
  "keywords": [
    "nestjs",
    "nodejs"
  ],
  "author": {
    "name": "Micael Levi L. C.",
    "url": "https://github.com/micalevisk"
  },
  "homepage": "https://github.com/micalevisk/card",
  "bugs": {
    "url": "https://github.com/micalevisk/try-nest/issues"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ],
    "branches": [
      "main"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "lefthook": "^2.1.14",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "tar-stream": "^3.2.1"
  }
}
