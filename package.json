{
  "name": "try-nest",
  "version": "0.0.0-development.1",
  "description": "A CLI tool to access NestJS samples easily.",
  "type": "module",
  "bin": {
    "try-nest": "bin/try-nest.js",
    "try-nestjs": "bin/try-nest.js"
  },
  "files": [
    "bin/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/micalevisk/try-nest"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "format": "prettier --write ."
  },
  "keywords": [
    "nestjs",
    "nodejs"
  ],
  "author": {
    "name": "Micael Levi L. C.",
    "url": "https://github.com/micalevisk"
  },
  "homepage": "https://github.com/micalevisk/card",
  "bugs": {
    "url": "https://github.com/micalevisk/try-nest/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "prettier": {
    "arrowParens": "always",
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "auto",
    "useTabs": false,
    "semi": true,
    "tabWidth": 2
  }
}
